# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (safe in the browser). Starts with sb_publishable_
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Secret key: NOT used by this app (it has no server code). Never prefix it with NEXT_PUBLIC_
# and never put it in the browser. Listed only so you know where it would go.
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
